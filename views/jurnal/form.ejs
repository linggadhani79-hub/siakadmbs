<%- include('../partials/header') %>

<div class="card" style="max-width:760px;">
  <div class="card-head"><h3><%= title %></h3></div>
  <div class="card-body">
    <form method="post" action="<%= action %>">
      <div class="form-grid">
        <div class="form-row"><label>Tanggal *</label><input type="date" name="tanggal" value="<%= jurnal.tanggal || '' %>" required></div>
        <div class="form-row"><label>Jam Ke-</label><input type="text" name="jam_ke" value="<%= jurnal.jam_ke || '' %>" placeholder="mis. 1-2"></div>
        <div class="form-row"><label>Guru *</label>
          <select name="guru_id" required>
            <% guru.forEach(g => { const sel = jurnal.guru_id ? String(jurnal.guru_id)===String(g.id) : (user.ref_id && String(user.ref_id)===String(g.id)); %>
              <option value="<%= g.id %>" <%= sel?'selected':'' %>><%= g.nama %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-row"><label>Kelas *</label>
          <select name="kelas_id" required><% kelas.forEach(k => { %><option value="<%= k.id %>" <%= String(jurnal.kelas_id)===String(k.id)?'selected':'' %>><%= k.nama %> (<%= k.jenjang %>)</option><% }) %></select>
        </div>
        <div class="form-row"><label>Mata Pelajaran *</label>
          <select name="mapel_id" required><% mapel.forEach(m => { %><option value="<%= m.id %>" <%= String(jurnal.mapel_id)===String(m.id)?'selected':'' %>><%= m.nama %></option><% }) %></select>
        </div>
        <div class="form-row"><label>Metode</label><input type="text" name="metode" value="<%= jurnal.metode || '' %>" placeholder="mis. Ceramah, diskusi"></div>
        <div class="form-row"><label>Jumlah Hadir</label><input type="number" name="kehadiran" value="<%= jurnal.kehadiran || 0 %>" min="0"></div>
        <div class="form-row"><label>Total Siswa</label><input type="number" name="total_siswa" value="<%= jurnal.total_siswa || 0 %>" min="0"></div>
      </div>
      <div class="form-row"><label>Materi / Pokok Bahasan *</label><textarea name="materi" required><%= jurnal.materi || '' %></textarea></div>
      <div class="form-row"><label>Catatan</label><textarea name="catatan"><%= jurnal.catatan || '' %></textarea></div>
      <div class="form-actions"><button class="btn">Simpan</button><a href="/jurnal" class="btn btn-muted">Batal</a></div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
