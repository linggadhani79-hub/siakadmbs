<%- include('../partials/header') %>

<div class="card" style="max-width:760px;">
  <div class="card-head"><h3><%= title %></h3></div>
  <div class="card-body">
    <form method="post" action="<%= action %>">
      <div class="form-grid">
        <div class="form-row">
          <label>NIS</label>
          <input type="text" name="nis" value="<%= siswa.nis || '' %>">
        </div>
        <div class="form-row">
          <label>Nama Lengkap *</label>
          <input type="text" name="nama" value="<%= siswa.nama || '' %>" required>
        </div>
        <div class="form-row">
          <label>Jenis Kelamin *</label>
          <select name="jk" required>
            <option value="L" <%= siswa.jk==='L'?'selected':'' %>>Laki-laki</option>
            <option value="P" <%= siswa.jk==='P'?'selected':'' %>>Perempuan</option>
          </select>
        </div>
        <div class="form-row">
          <label>Tempat Lahir</label>
          <input type="text" name="tempat_lahir" value="<%= siswa.tempat_lahir || '' %>">
        </div>
        <div class="form-row">
          <label>Tanggal Lahir</label>
          <input type="date" name="tgl_lahir" value="<%= siswa.tgl_lahir || '' %>">
        </div>
        <div class="form-row">
          <label>No. HP Wali</label>
          <input type="text" name="no_hp" value="<%= siswa.no_hp || '' %>">
        </div>
        <div class="form-row">
          <label>Nama Wali / Orang Tua</label>
          <input type="text" name="wali_ortu" value="<%= siswa.wali_ortu || '' %>">
        </div>
        <div class="form-row">
          <label>Kelas</label>
          <select name="kelas_id">
            <option value="">- Belum ditentukan -</option>
            <% kelas.forEach(k => { %>
              <option value="<%= k.id %>" <%= String(siswa.kelas_id)===String(k.id)?'selected':'' %>><%= k.nama %> (<%= k.jenjang %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="form-row">
          <label>Kamar Asrama</label>
          <select name="kamar_id">
            <option value="">- Belum ditempatkan -</option>
            <% kamar.forEach(km => { %>
              <option value="<%= km.id %>" <%= String(siswa.kamar_id)===String(km.id)?'selected':'' %>><%= km.asrama %> · <%= km.nama %> (<%= km.gender %>)</option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="form-row">
        <label>Alamat</label>
        <textarea name="alamat"><%= siswa.alamat || '' %></textarea>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn">Simpan</button>
        <a href="/siswa" class="btn btn-muted">Batal</a>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
