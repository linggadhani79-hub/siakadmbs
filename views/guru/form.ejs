<%- include('../partials/header') %>

<div class="card" style="max-width:640px;">
  <div class="card-head"><h3><%= title %></h3></div>
  <div class="card-body">
    <form method="post" action="<%= action %>">
      <div class="form-grid">
        <div class="form-row"><label>NIP</label><input type="text" name="nip" value="<%= guru.nip || '' %>"></div>
        <div class="form-row"><label>Nama Lengkap *</label><input type="text" name="nama" value="<%= guru.nama || '' %>" required></div>
        <div class="form-row"><label>Jenis Kelamin</label>
          <select name="jk"><option value="L" <%= guru.jk==='L'?'selected':'' %>>Laki-laki</option><option value="P" <%= guru.jk==='P'?'selected':'' %>>Perempuan</option></select>
        </div>
        <div class="form-row"><label>No. HP</label><input type="text" name="no_hp" value="<%= guru.no_hp || '' %>"></div>
      </div>
      <div class="form-row"><label>Jabatan</label><input type="text" name="jabatan" value="<%= guru.jabatan || '' %>" placeholder="mis. Guru Matematika / Musyrif Tahfidz"></div>
      <div class="form-actions"><button class="btn">Simpan</button><a href="/guru" class="btn btn-muted">Batal</a></div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
